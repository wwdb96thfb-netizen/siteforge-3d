{
  "name": "sentinel-3d",
  "productName": "Sentinel 3D",
  "version": "3.1.0",
  "description": "Sentinel 3D — Tactical Site Planning (offline desktop edition)",
  "author": "Syed Iftikhar Shah",
  "copyright": "Copyright © 2026 Syed Iftikhar Shah. All rights reserved.",
  "license": "UNLICENSED",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --publish never",
    "release": "electron-builder --publish always"
  },
  "dependencies": {
    "electron-updater": "6.3.9"
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "com.syediftikharshah.sentinel3d",
    "productName": "Sentinel 3D",
    "copyright": "Copyright © 2026 Syed Iftikhar Shah. All rights reserved.",
    "asar": true,
    "files": ["main.js", "preload.js", "app/**/*", "package.json"],
    "directories": { "buildResources": "build", "output": "dist" },
    "fileAssociations": [
      { "ext": "s3d", "name": "Sentinel 3D Protected Project", "role": "Editor" },
      { "ext": "g3d", "name": "Sentinel 3D Project", "role": "Editor" }
    ],
    "publish": [{ "provider": "github", "owner": "wwdb96thfb-netizen", "repo": "siteforge-3d", "releaseType": "release" }],
    "win": {
      "target": [{ "target": "nsis", "arch": ["x64"] }],
      "icon": "build/icon.png",
      "artifactName": "Sentinel-3D-Setup-${version}.exe"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Sentinel 3D",
      "license": "build/license.txt",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false
    },
    "mac": {
      "target": [{ "target": "dmg", "arch": ["universal"] }, { "target": "zip", "arch": ["universal"] }],
      "icon": "build/icon.png",
      "category": "public.app-category.productivity",
      "artifactName": "Sentinel-3D-${version}-mac.${ext}",
      "hardenedRuntime": false,
      "identity": null
    },
    "dmg": {
      "title": "Sentinel 3D ${version}",
      "contents": [{ "x": 150, "y": 190 }, { "x": 410, "y": 190, "type": "link", "path": "/Applications" }],
      "window": { "width": 560, "height": 380 }
    }
  }
}
